{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BandHeartBeat",
  "version": "0.2.0",
  "identifier": "app.bandheartbeat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BandHeartBeat",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#0F0D16",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": { "../../vcam/out/BandHeartBeatCamera.dll": "BandHeartBeatCamera.dll" }
  }
}
